// Cloudflare Workers static assets: an assets-only Worker serving the Vite build output.
// Deployed by .github/workflows/deploy-cloudflare.yml (`wrangler deploy` after `npm run build`).
{
  "name": "metronome",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html instead of a 404 (single-page app).
    "not_found_handling": "single-page-application"
  }
}
