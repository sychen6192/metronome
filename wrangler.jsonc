// Cloudflare Workers static assets: an assets-only Worker serving the Vite build output.
// Deployed by .github/workflows/deploy-cloudflare.yml (`wrangler deploy` after `npm run build`).
{
  "name": "metronome",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    // The app has no client-side routes: unknown paths get 404.html with a 404 status, so search
    // engines never see them as copies of the home page (soft 404s).
    "not_found_handling": "404-page"
  }
}
