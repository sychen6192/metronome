{
  "name": "metronome",
  "private": true,
  "version": "1.0.0",
  "description": "A precise, offline-capable PWA metronome built on the Web Audio API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
